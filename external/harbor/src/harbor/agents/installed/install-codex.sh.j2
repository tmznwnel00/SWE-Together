#!/bin/bash
set -euo pipefail

# Detect musl (Alpine) vs glibc — NVM doesn't support musl, so use apk for Alpine
if ldd --version 2>&1 | grep -qi musl || [ -f /etc/alpine-release ]; then
    echo "Detected Alpine/musl — installing Node.js via apk"
    apk add --no-cache curl bash nodejs npm ripgrep

    {% if version %}
    npm install -g @openai/codex@{{ version }}
    {% else %}
    npm install -g @openai/codex@0.117.0
    {% endif %}
else
    # [local-run] The task images run as a non-root user and sinkhole github.com / raw.githubusercontent.com,
    # so the stock apt + nvm path cannot run: Node comes from nodejs.org, Codex from the npm registry, both into $HOME/.local.
    export PATH="$HOME/.local/bin:$PATH"
    if ! command -v node &>/dev/null; then
        case "$(uname -m)" in x86_64) arch=x64;; aarch64|arm64) arch=arm64;; *) arch=x64;; esac
        f=$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt | grep -oE "node-v[0-9.]+-linux-$arch\.tar\.gz" | head -1)
        mkdir -p "$HOME/.local"
        curl -fsSL "https://nodejs.org/dist/latest-v22.x/$f" | tar xz -C "$HOME/.local" --strip-components=1
    fi
    npm -v

    {% if version %}
    npm install -g --prefix "$HOME/.local" @openai/codex@{{ version }}
    {% else %}
    npm install -g --prefix "$HOME/.local" @openai/codex@0.117.0
    {% endif %}
fi

# Symlink node/codex to /usr/local/bin so they're always on PATH
# regardless of whether nvm.sh is sourced in later sessions.
# Skip if already in /usr/local/bin (e.g. Alpine's apk puts them there).
for bin in node codex; do
    BIN_PATH="$(which "$bin")"
    if [ "$BIN_PATH" != "/usr/local/bin/$bin" ] && [ -w /usr/local/bin ]; then
        ln -sf "$BIN_PATH" "/usr/local/bin/$bin"
    fi
done

codex --version
